# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# Never commit the real .env: it's git-ignored.

# Required: API key for the course Portkey gateway (OpenAI-compatible). The agent reads it from here.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides (the defaults are shown)
# CAMPUS_AGENT_MODEL=gpt-5.6-luna
# PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional: secret for signing login cookies. If unset, a random one is generated in data/.session_secret.
# SESSION_SECRET=replace-with-a-long-random-string

# Optional: set to 1 when serving over HTTPS so login cookies are marked Secure.
# COOKIE_SECURE=0
